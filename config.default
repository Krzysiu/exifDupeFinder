; For the full information and tips, see readme.md

[Core]
; The directory containing photos. If empty, script uses the current directory.
; If command line argument is given, it overrides this setting.
photoDir = ""

; Finding duplicates based on visual content (ignores all metadata). Slow but accurate.
; It overrides fetchTags and compareTags.
imageHashMode = 0

; [optional] File extensions to process (comma-separated). Use "" for all files. Case insensitive.
; If left empty, check all ExifTool supported files
extensions = "jpg,jpeg,cr2,nef,mrw,tif,tiff"

[Exif]
; Specific tags to extract from files (comma-separated).
fetchTags = "DateTimeOriginal,SubSecTime"

; [optional] Pattern used to determine duplicates. Format: same as fetchTags
; If left empty, it will be automatically generated from fetchTags.
compareTags = ""

; Additional Exiftool parameters (see https://exiftool.org/exiftool_pod.html)
; Remember that formatting parameters won't change what you see, but can cause
; this script to fail to understand ExifTool.
exifToolParameters = "-m"

[UI]
; Detail level for ExifTool: 0 = Silent, 1 = Errors, 2 = Full.
displayOutput = 2
; Use colors on the screen: 0 = off, 1 = on.
enableColorOutput = 1
; 0 = CSV format for machines, 1 = pretty ouput for humans; 
prettyPrint = 1